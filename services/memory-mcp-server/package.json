{
  "name": "@super-agent/memory-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/services/memory-mcp-server/src/index.js",
  "types": "dist/services/memory-mcp-server/src/index.d.ts",
