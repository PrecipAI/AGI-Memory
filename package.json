{
  "name": "super-agent-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "services/*",
    "libs/*"
  ],
  "scripts": {
    "generate:contracts": "node ./scripts/generate-contracts.mjs",
    "db:migrate": "node ./scripts/run-migration.mjs",
    "db:snapshot": "node ./scripts/generate-schema-snapshot.mjs",
    "db:seed": "node ./scripts/seed-dev.mjs",
    "graph:rebuild": "python ./scripts/rebuild-graphify-curated.py",
    "verify:memory": "node ./scripts/run-migration.mjs && node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/seed-dev.mjs && node ./scripts/verify-memory-system.mjs",
    "verify:p1-golden": "node ./scripts/run-migration.mjs && node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/verify-p1-golden.mjs",
    "verify:mcp": "node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/verify-memory-mcp.mjs",
    "verify:mcp-client-smoke": "node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/verify-memory-mcp-client-smoke.mjs",
    "verify:mcp-real-service": "node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/verify-memory-mcp-real-service.mjs",
    "verify:mcp-cli": "node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/verify-memory-mcp-cli.mjs",
    "verify:mcp-pack": "node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/verify-memory-mcp-pack.mjs",
    "verify:codex-host-capture": "npm run build && node ./scripts/verify-codex-host-capture-preview.mjs",
    "verify:codex-governance-batch": "npm run build && node ./scripts/verify-codex-governance-batch-preview.mjs",
    "verify:codex-governance-run": "node ./scripts/run-migration.mjs && node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/seed-dev.mjs && node ./scripts/verify-codex-governance-run.mjs",
    "verify:host-model-governance": "node ./scripts/run-migration.mjs && node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/seed-dev.mjs && node ./scripts/verify-host-model-governance-run.mjs",
    "verify:multi-host-governance": "node ./scripts/run-migration.mjs && node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/seed-dev.mjs && node ./scripts/verify-multi-host-capture-governance.mjs",
    "verify:governance-extraction-quality": "npm run build && node ./scripts/verify-governance-extraction-quality.mjs",
    "verify:governance-prompt-contract": "npm run build && node ./scripts/verify-governance-prompt-contract.mjs",
    "verify:rule-phase-routing": "node ./scripts/run-migration.mjs && node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/seed-dev.mjs && node ./scripts/verify-rule-phase-routing.mjs",
    "eval:governance:golden-50": "npm run build && node ./scripts/run-governance-golden-50-eval.mjs",
    "eval:governance:live-50": "npm run build && node ./scripts/run-governance-live-model-eval.mjs",
    "eval:governance:split": "node ./scripts/split-governance-dataset.mjs",
    "cleanup:host-governance": "node ./scripts/cleanup-host-governance-artifacts.mjs",
    "governance:codex:all": "npm run build && node ./scripts/run-codex-all-governance.mjs",
    "verify:governance-complete": "npm run verify:memory && npm run verify:knowledge && npm run verify:mcp && npm run verify:mcp-cli && npm run verify:mcp-pack",
    "verify:knowledge": "node ./scripts/run-migration.mjs && node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/seed-dev.mjs && node ./scripts/verify-knowledge-platform.mjs",
    "verify:knowledge:basic-graph": "node ./scripts/verify-basic-graph-contract.mjs",
    "materialize:knowledge:ai-dev": "node ./scripts/materialize-ai-dev-markdown-sources.mjs",
    "verify:knowledge:markdown-materialization": "node ./scripts/verify-ai-dev-markdown-materialization.mjs",
    "verify:knowledge:ai-dev-ingest": "node ./scripts/verify-ai-dev-materialized-ingest.mjs",
    "knowledge:quarantine-low-quality": "node ./scripts/quarantine-low-quality-knowledge-documents.mjs",
    "knowledge:govern-corpus-noise": "node ./scripts/govern-knowledge-corpus-noise.mjs",
    "knowledge:purge-intermediate-artifacts": "node ./scripts/purge-knowledge-intermediate-artifacts.mjs",
    "verify:embedding-service": "node ./scripts/verify-embedding-service.mjs",
    "verify:knowledge:milvus": "node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/verify-milvus-vector-backend.mjs",
    "eval:knowledge:real": "node ./scripts/generate-contracts.mjs && npm run build && node ./scripts/run-knowledge-real-eval.mjs && node ./scripts/render-knowledge-eval-report.mjs",
    "eval:knowledge:capability": "node ./scripts/run-knowledge-capability-eval.mjs",
    "eval:knowledge:complete": "node ./scripts/run-knowledge-capability-eval.mjs ./tests/knowledge-benchmark/knowledge-complete-capability-cases.v1.json ./tests/knowledge-benchmark/reports/knowledge-complete-capability-report.json ./tests/knowledge-benchmark/reports/knowledge-complete-capability-report.md",
    "report:knowledge:current": "node ./scripts/export-knowledge-system-current-report.mjs",
    "build": "npm run build --ws --if-present",
    "typecheck": "npm run typecheck --ws --if-present",
    "start:memory-service": "npm --workspace @super-agent/memory-service run start",
    "start:memory-mcp": "npm --workspace @super-agent/memory-mcp run start",
    "memory-mcp:init": "npm --workspace @super-agent/memory-mcp run init",
    "memory-mcp:doctor": "npm --workspace @super-agent/memory-mcp run doctor",
    "memory-mcp:start": "npm --workspace @super-agent/memory-mcp run start",
    "dev:task-orchestrator": "npm --workspace @super-agent/task-orchestrator run dev",
    "dev:registry-service": "npm --workspace @super-agent/registry-service run dev",
    "dev:memory-service": "npm --workspace @super-agent/memory-service run dev",
    "dev:memory-mcp": "npm --workspace @super-agent/memory-mcp run dev",
    "dev:verification-service": "npm --workspace @super-agent/verification-service run dev",
    "dev:cleanup-coordinator": "npm --workspace @super-agent/cleanup-coordinator run dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.2",
    "openapi-typescript": "^7.8.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  }
}
